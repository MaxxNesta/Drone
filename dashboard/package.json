{
  "name": "drone-mission-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "next build --webpack",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib server tests *.ts *.mjs *.json",
    "format:check": "prettier --check app components lib server tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
