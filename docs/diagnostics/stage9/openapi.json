            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vehicle Id"
          }
        },
        "required": [
          "run_id",
          "request_id",
          "command"
        ],
        "title": "Command",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
